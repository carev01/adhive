# AdHive Frontend Environment Configuration
# Copy this file to .env and customize as needed

# ============================================
# API Configuration
# ============================================
# Base URL for API calls
# For development with proxy: leave empty or use /
# For standalone deployment: http://localhost:8080 or your domain
# VITE_API_URL=

# ============================================
# Feature Flags
# ============================================
# Enable debug mode (shows extra logging)
# VITE_DEBUG=false
