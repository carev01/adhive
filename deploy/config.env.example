# AdHive Configuration
# Copy this file to /etc/adhive/config.env for systemd deployment

# ===========================================
# REQUIRED (Production)
# ===========================================

# Session secret for secure cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-secure-random-string

# ===========================================
# Server Configuration
# ===========================================

# Port the server listens on
PORT=8080

# Environment: development or production
GO_ENV=production

# ===========================================
# Data Configuration
# ===========================================

# Base directory for all data (database, archives, thumbnails)
# Systemd default: /var/lib/adhive/data
DATA_DIR=/var/lib/adhive/data

# ===========================================
# Security Configuration
# ===========================================

# Enable HTTPS (affects cookie security and HSTS)
HTTPS_ENABLED=false

# CORS allowed origins (comma-separated)
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# ===========================================
# Rate Limiting
# ===========================================

# Global rate limit (requests per minute)
RATE_LIMIT_GLOBAL=100

# Auth rate limit (requests per minute)
RATE_LIMIT_AUTH=5

# ===========================================
# Logging
# ===========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info