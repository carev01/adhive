# Ad Catalog Environment Configuration
# Copy this file to .env and customize as needed

# Server Configuration
# --------------------
# Port the server listens on (default: 8080)
PORT=8080

# Database Configuration
# ----------------------
# Path to SQLite database file (default: ad-catalog.db)
DB_PATH=ad-catalog.db

# Storage Configuration
# ---------------------
# Base directory for file storage (archives, thumbnails, etc.)
# Default: ./data
STORAGE_DIR=./data

# Playwright Scraper Configuration
# --------------------------------
# Optional: Override the Chrome User-Agent. If unset, the scraper
# auto-detects the Chrome version from the bundled Chromium binary
# (currently 145). This ensures User-Agent, sec-ch-ua, and TLS
# fingerprints are consistent.
USER_AGENT=

# Comma-separated list of domains that require manual/headful capture mode
# (human intervention for CAPTCHAs, complex challenges, etc.)
HUMAN_DOMAINS=

# Security Configuration
# ---------------------
# Session secret for JWT signing (generate a secure random string)
# SESSION_SECRET=your-secure-secret-here

# CORS Configuration
# Comma-separated list of allowed origins for CORS.
# If empty in production, no cross-origin requests are allowed.
# Development defaults to localhost:5173,localhost:3000,localhost:8080
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# CORS_ALLOWED_ORIGINS=

# Logging
# -------
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info